# Todas opcionais. Na Vercel: Project Settings → Environment Variables. Na Netlify: Site configuration → Environment variables.

# URL pública do site (sem barra no final). Sem ela, usa o domínio de produção da Vercel
# ou o `url` do site.config.ts.
NEXT_PUBLIC_SITE_URL=https://www.exemplo.com.br

# Sobrescreve o plano do config no build: essencial | premium | profissional
# SITE_PLAN=essencial

# 1 = mantém o site fora do Google mesmo em produção (ex.: aguardando aprovação do cliente).
# SITE_NOINDEX=1

# Plano "profissional" (V3): sistema de agendamento. Só liga com as duas variáveis abaixo.
# SITE_PLAN=profissional
# NEXT_PUBLIC_SUPABASE_URL=https://<projeto>.supabase.co
# Chave PUBLISHABLE (sb_publishable_...) ou ANON. NUNCA a secreta/service_role: o build recusa.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
